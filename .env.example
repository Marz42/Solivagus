# Solivagus local secrets — copy to `.env` and fill in.
# NEVER commit the real `.env` file.

# DeepSeek / OpenAI-compatible API
LLM_API_BASE=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash

# Solivagus workspace
# SOLIVAGUS_WORKSPACE=
# Batch PDF directory for Phase 8 (optional; CLI `solivagus batch <dir>` also works)
# SOLIVAGUS_BATCH_DIR=
# SOLIVAGUS_ENV_FILE=
